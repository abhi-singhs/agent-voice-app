{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Voice App",
  "version": "0.1.0",
  "identifier": "in.abhisingh.agent-voice-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/prepare-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Voice App",
        "width": 420,
        "height": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Talk to the Copilot agent like a phone call.",
    "longDescription": "Agent Voice App is a desktop phone for your Copilot agent. The agent calls you through an MCP server; you answer in the app and have a spoken back-and-forth using ElevenLabs text-to-speech and speech-to-text.",
    "copyright": "Copyright © 2026 abhi-singh",
    "externalBin": ["binaries/agent-voice-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
